# FreightFlow AI - Environment Variables Template
# Copy this file to .env and populate with your local values

# Environment Mode: development / production / testing
ENVIRONMENT=development

# Database Settings
DATABASE_URL=sqlite:///./freightflow.db

# LLM Configuration (e.g. Google Gemini, OpenAI, or Local LLM)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=your_openai_api_key_here

# Simulation Settings
DEFAULT_SIMULATION_ROUNDS=3
EVALUATION_RUNS=50
RANDOM_SEED=42
